{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "replay:webhook": "powershell -ExecutionPolicy Bypass -File ./scripts/replay-github-webhook.ps1",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@ai-sdk/devtools": "^0.0.2",
    "@ai-sdk/openai": "^3.0.41",
    "@hackathon/api": "workspace:*",
    "@hackathon/auth": "workspace:*",
    "@hackathon/db": "workspace:*",
    "@hackathon/env": "workspace:*",
    "@hackathon/github-doc-agent": "workspace:*",
    "@hackathon/github-testing-agent": "workspace:*",
    "@hono/trpc-server": "^0.4.0",
    "@trpc/server": "catalog:",
    "ai": "catalog:",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hackathon/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "^5"
  }
}
